# Copy to .env and fill in. `.env` is gitignored.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model id. Gemini 2.x flash is fast + supports structured outputs.
HERMETIC_MODEL=gemini-3.5-flash-lite

# --- Loop control ---
HERMETIC_MAX_ITERATIONS=5
HERMETIC_STAGNATION_THRESHOLD=0.02   # <2% Levenshtein delta over 2 fails => force pivot

# --- Sandbox hardening ---
HERMETIC_WALLCLOCK_SECONDS=5.0       # hard TTL enforced by the watchdog
HERMETIC_MEM_LIMIT=128m
HERMETIC_CPU_SHARES=512
HERMETIC_PIDS_LIMIT=50
HERMETIC_IMAGE_TAG=hermetic-sandbox:1

# Pinned base image (digest is verified/derived at build time; see hermetic/Dockerfile.sandbox)
HERMETIC_BASE_IMAGE=python:3.11-slim
